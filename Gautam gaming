
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gautam Gaming Zone</title>
<style>
body {
  background: #101020;
  color: white;
  font-family: Arial;
  text-align: center;
  padding: 20px;
}
h1 { color: #00eaff; }
.game {
  background: #252545;
  padding: 25px;
  border-radius: 15px;
  margin: 20px auto;
  max-width: 400px;
}
button {
  background: #00eaff;
  padding: 15px 25px;
  border: none;
  border-radius: 10px;
  font-size: 18px;
}
</style>
</head>
<body>

<h1>🎮 Gautam Gaming Zone</h1>
<p>Welcome to My Gaming Website!</p>

<div class="game">
<h2>Tap Challenge</h2>
<p>Click the button and increase your score!</p>
<h1 id="score">0</h1>
<button onclick="play()">PLAY GAME</button>
</div>

<script>
let score = 0;

function play() {
  score++;
  document.getElementById("score").innerText = score;
}
</script>

</body>
</html>
